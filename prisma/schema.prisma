datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("CUSTOMER") // CUSTOMER, ADMIN, SUPER_ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  reviews      Review[]
  notifications Notification[]
  auditLogs    AuditLog[]
}

model Admin {
  id          String    @id @default(cuid())
  userId      String    @unique
  permissions String    @default("ALL")
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  productCount Int      @default(0)
  createdAt   DateTime  @default(now())
}

model Product {
  id              String             @id @default(cuid())
  sku             String             @unique
  name            String
  slug            String             @unique
  description     String?
  categoryName    String
  sellingPrice    Float
  mrp             Float
  discountPercent Int                @default(0)
  stock           Int                @default(50)
  status          String             @default("DRAFT") // DRAFT, APPROVED, ARCHIVED
  isApproved      Boolean            @default(false)
  isFeatured      Boolean            @default(false)
  isTrending      Boolean            @default(false)
  isBestSeller    Boolean            @default(false)
  hasImage        Boolean            @default(true)
  imageUrl        String
  specifications  String?            // JSON string of specs
  rawName         String?
  pageNumber      Int?
  supplierName    String             @default("DeoDap Wholesale")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  images          ProductImage[]
  variations      ProductVariation[]
  supplierCosts   SupplierCost[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  altText   String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariation {
  id         String   @id @default(cuid())
  productId  String
  name       String
  sku        String   @unique
  stock      Int      @default(0)
  extraPrice Float    @default(0.0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Strictly private supplier cost table - Never accessible to customer APIs
model SupplierCost {
  id             String    @id @default(cuid())
  productId      String
  supplierId     String?
  costPrice      Float
  moq            Int       @default(1)
  isVerified     Boolean   @default(true)
  lastVerifiedAt DateTime  @default(now())
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Supplier {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  orders      SupplierOrder[]
}

model SupplierOrder {
  id             String    @id @default(cuid())
  poNumber       String    @unique
  supplierId     String
  orderId        String?
  status         String    @default("PENDING") // PENDING, CONFIRMED, DISPATCHED, DELIVERED
  totalCost      Float
  trackingNumber String?
  dispatchedAt   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pinCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  userId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddress     String      // JSON address
  paymentMethod       String      // RAZORPAY, COD, BANK_TRANSFER
  paymentStatus       String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus         String      @default("ORDER_PLACED") // ORDER_PLACED, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  subtotal            Float
  shippingFee         Float       @default(0.0)
  discount            Float       @default(0.0)
  totalAmount         Float
  cancellationReason  String?
  cancelRequested     Boolean     @default(false)
  isCancelled         Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  shipments           Shipment[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  sku         String
  productName String
  quantity    Int
  price       Float
  total       Float
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  paymentMethod String
  paymentId     String?  // Gateway transaction ID
  signature     String?  // Razorpay signature
  amount        Float
  status        String   @default("PENDING") // SUCCESS, PENDING, FAILED
  rawResponse   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Refund {
  id          String    @id @default(cuid())
  orderId     String
  amount      Float
  reason      String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  approvedBy  String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String
  userName           String
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENT") // PERCENT, FIXED
  discountValue  Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  isActive       Boolean   @default(true)
  usedCount      Int       @default(0)
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  carrier        String    @default("Delhivery / Bluedart / Ecom Express")
  trackingNumber String
  trackingUrl    String?
  status         String    @default("MANIFESTED")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("ORDER")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebsiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

